# ─── Oryon Frontend Environment ──────────────────────────────────────────────

# Backend NestJS (Servidor 1 — CRM + WhatsApp)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# Agent Server (Servidor 2 — IA + Copilot)
VITE_AGENT_SERVER_URL=http://localhost:3002

# SEM chaves de API no frontend — tudo fica nos servidores

# Billing / Plano & Faturamento (SCRUM-172/154)
# Controla a aba "Plano & Faturamento" em Configurações (adminOnly).
# Off por padrão (omitir ou false). Em homologação: true. Em prod: true só
# depois do backend com migrations Asaas + ledger no ar.
# Reinicie o Vite após mudar (vars VITE_* são lidas no boot).
VITE_SETTINGS_BILLING=true

# Opcional: logs console para mídia/uploads ([MEDIA-IN][FE] / [AUDIO-IN][FE])
# Ou em runtime: localStorage.setItem('oryon:debug:media','1')
# VITE_DEBUG_MEDIA=true
